# Copy to .env and fill in. Never commit .env.

# --- AI ---------------------------------------------------------------
# Claude ranks the viral moments and writes titles/hooks. Without a key the
# pipeline still works but falls back to signal-only (heuristic) ranking.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high            # low | medium | high | xhigh | max

# Whisper (faster-whisper / CTranslate2)
WHISPER_MODEL=large-v3-turbo  # use "small" on low-RAM CPU machines
WHISPER_DEVICE=auto           # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=auto     # auto | int8 | float16

# --- YouTube ----------------------------------------------------------
# If downloads fail with "Sign in to confirm you're not a bot", export YouTube
# cookies (Netscape format) to ./secrets/cookies.txt. Docker mounts it automatically.
YTDLP_COOKIES_FILE=

# --- Runtime ----------------------------------------------------------
ENV=development
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0
MEDIA_ROOT=./data/media
WORK_ROOT=./data/work
FACE_MODEL_PATH=./models/face_detection_yunet_2023mar.onnx
CORS_ORIGINS=["http://localhost:3000"]

# --- Limits -----------------------------------------------------------
MAX_VIDEO_SECONDS=10800
RATE_LIMIT_PER_HOUR=20
JOB_TTL_SECONDS=604800
WORKER_REPLICAS=1

# --- Web --------------------------------------------------------------
# Leave empty to proxy through Next.js rewrites (recommended).
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://localhost:8000
